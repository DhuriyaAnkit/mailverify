# Port for the API server (default 8000)
PORT=8000

# Allowed frontend domains for CORS (comma-separated).
# Example: https://mailverify.vercel.app,https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Regex for matching deployment preview URLs (defaults to https://.*\.vercel\.app)
ALLOWED_ORIGIN_REGEX=https://.*\.vercel\.app
